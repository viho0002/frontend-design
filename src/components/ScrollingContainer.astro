---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .full-width {
    grid-column: 1/-1;
  }

  ul {
    display: flex;
    overflow-x: auto;
    gap: var(--card-gap);
    scroll-snap-type: inline mandatory;
    scroll-snap-stop: always;
    list-style: none;
    padding-inline: max(1rem, 50% - var(--content-width) / 2);
    scroll-padding-inline-start: max(1rem, 50% - var(--content-width) / 2);

    :has(> &) {
      display: grid;
      grid-template-columns: 1fr minmax(0, var(--content-width)) 1fr;
      grid-column: 1/-1;
      > * {
        grid-column: 2;
      }
    }
    li {
      background-color: var(--card-background);
      color: var(--card-text-color);
      padding: var(--card-padding);
      border-radius: var(--card-border-radius);
      flex: 1 0 min(90%, 400px);
      scroll-snap-align: start;
    }
  }
</style>
